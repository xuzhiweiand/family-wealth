{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "lib": ["ES2022", "DOM"],
    "moduleResolution": "bundler",
    "module": "ESNext",
    "allowJs": true,
    "noEmit": true,
    "types": ["react-native", "jest"],
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@assets/*": ["./assets/*"]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx"
  ],
  "exclude": [
    "node_modules",
    "android",
    "ios",
    "dist",
    "harmony/**/oh_modules",
    "harmony/**/build",
    "harmony/hvigorfile.ts",
    "harmony/**/hvigorfile.ts"
  ]
}
