# ===== Supabase（公共，前端可见）=====
# 客户端连接需用 anon key，不要泄露 service_role key
EXPO_PUBLIC_SUPABASE_URL=https://<project>.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=<anon-key>

# ===== Sentry（崩溃监控，公开发布用）=====
EXPO_PUBLIC_SENTRY_DSN=

# ===== PostHog（产品分析）=====
EXPO_PUBLIC_POSTHOG_API_KEY=
EXPO_PUBLIC_POSTHOG_HOST=

# ===== 本地开发变体 =====
APP_ENV=development
