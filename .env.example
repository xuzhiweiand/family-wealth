# ===== Supabase（公共，前端可见）=====
# 客户端连接需用 anon key，不要泄露 service_role key
#
# 腾讯云自托管：部署 deploy/server/setup.sh 后，把脚本输出的
# API 地址与 ANON KEY 填入下方（地址形如 http://<公网IP>:8000）
EXPO_PUBLIC_SUPABASE_URL=http://<服务器公网IP>:8000
EXPO_PUBLIC_SUPABASE_ANON_KEY=<部署脚本输出的 anon key>

# ===== Sentry（崩溃监控，公开发布用）=====
EXPO_PUBLIC_SENTRY_DSN=

# ===== PostHog（产品分析）=====
EXPO_PUBLIC_POSTHOG_API_KEY=
EXPO_PUBLIC_POSTHOG_HOST=

# ===== 本地开发变体 =====
APP_ENV=development
